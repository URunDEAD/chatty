msgid "PGP user ID"
msgstr "PGP felhasználó-azonosító"

#: data/sm.puri.Chatty.gschema.xml:125
msgid "The user ID for PGP that Chatty will use for outgoing messages"
msgstr ""
"A PGP felhasználó-azonosítója, amelyet a Chatty a kimenő üzenetekhez fog "
"használni"

