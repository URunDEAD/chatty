msgstr "Да ли се апликација покреће први пут"

#: data/sm.puri.Chatty.gschema.xml:13
msgid "Country code in ISO 3166-1 alpha-2 format"
msgstr "Шифра државе у ISO 3166-1 алфа-2 формату"

#: data/sm.puri.Chatty.gschema.xml:14
msgid "Two letter country code of the last available SIM/Network"
msgstr "Шифра државе са два слова за последњи СИМ или мрежу"

